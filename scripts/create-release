#!/usr/bin/env python3

"""Cut a release by dispatching the Release workflow.

scripts/create-release [patch|minor|major] [--no-bump] [-y] [--no-watch]

Dispatches .github/workflows/release.yml on the default branch; the workflow
does everything remotely: bumps Cargo.toml, .claude-plugin/plugin.json, and
Cargo.lock in lockstep (make bump), runs make ci, pushes the bump commit and
the vX.Y.Z tag, builds the four platform binaries, and publishes the release
with them attached. Nothing happens locally — no commits, no tags, no clean
tree required — so this works from any checkout state and is unaffected by
branch protection (the workflow's own token does the pushing).

Re-running after a failed run resumes safely: the workflow skips the bump
when the tag already exists and points at the dispatch ref, and rebuilds.
With --no-bump, it releases the version already in Cargo.toml.

By default the script waits for the run and prints the release URL; pass
--no-watch to exit right after dispatching.

Requires the gh CLI (https://cli.github.com). Run from anywhere in the repo.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
WORKFLOW = "release.yml"
WATCH_TIMEOUT = 40 * 60  # bump + checks + four builds; macOS queues slowly
POLL_INTERVAL = 15

# The four assets the Release workflow builds and install-wizard.sh's
# download-binary path fetches from releases/latest/download.
ASSETS = (
    "tmux-agent-sidebar-darwin-aarch64",
    "tmux-agent-sidebar-darwin-x86_64",
    "tmux-agent-sidebar-linux-x86_64",
    "tmux-agent-sidebar-linux-aarch64",
)


def fail(msg: str) -> int:
    print(f"create-release FAILED: {msg}", file=sys.stderr)
    return 1


def run(cmd: list[str]) -> str:
    """Run a command, returning its stripped stdout; abort on failure."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise SystemExit(f"create-release FAILED: {' '.join(cmd)}\n{detail}")
    return result.stdout.strip()


def probe(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    """Run a command without aborting, for existence checks."""
    return subprocess.run(cmd, capture_output=True, text=True)


def origin_version(repo: str, branch: str) -> str | None:
    """Cargo.toml's version on the origin branch (local file as fallback)."""
    result = probe(
        [
            "gh",
            "api",
            f"repos/{repo}/contents/Cargo.toml?ref={branch}",
            "--jq",
            ".content",
        ]
    )
    if result.returncode == 0 and result.stdout.strip():
        try:
            decoded = base64.b64decode(result.stdout).decode()
            return tomllib.loads(decoded)["package"]["version"]
        except Exception:
            pass
    try:
        with open(REPO_ROOT / "Cargo.toml", "rb") as f:
            return tomllib.load(f)["package"]["version"]
    except Exception:
        return None


def bump_version(version: str, part: str) -> str:
    major, minor, patch = (int(x) for x in version.split("."))
    if part == "major":
        return f"{major + 1}.0.0"
    if part == "minor":
        return f"{major}.{minor + 1}.0"
    return f"{major}.{minor}.{patch + 1}"


def release_exists(repo: str, tag: str) -> bool:
    return (
        probe(
            ["gh", "release", "view", tag, "--repo", repo, "--json", "name"]
        ).returncode
        == 0
    )


def workflow_state(repo: str) -> str | None:
    """The Release workflow's enabled state, or None if it can't be read."""
    result = probe(
        [
            "gh",
            "api",
            f"repos/{repo}/actions/workflows/{WORKFLOW}",
            "--jq",
            ".state",
        ]
    )
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def confirm(prompt: str, assume_yes: bool) -> None:
    if assume_yes:
        return
    try:
        answer = input(f"{prompt} [y/N] ")
    except EOFError:
        raise SystemExit("create-release FAILED: aborted (no tty; pass --yes)")
    if answer.strip().lower() not in ("y", "yes"):
        raise SystemExit("create-release FAILED: aborted")


def watch_build(repo: str, branch: str, dispatched_after: str) -> dict | None:
    """Poll for the workflow_dispatch run this script just created."""
    print(
        f"waiting for the {WORKFLOW} run on {branch}"
        f" (up to {WATCH_TIMEOUT // 60} min)..."
    )
    deadline = time.monotonic() + WATCH_TIMEOUT
    announced = False
    while time.monotonic() < deadline:
        run_row = None
        result = probe(
            [
                "gh",
                "run",
                "list",
                "--repo",
                repo,
                f"--workflow={WORKFLOW}",
                "--limit",
                "30",
                "--json",
                "databaseId,headBranch,status,conclusion,url,event,createdAt",
            ]
        )
        if result.returncode == 0 and result.stdout.strip():
            for row in json.loads(result.stdout):
                if (
                    row.get("event") == "workflow_dispatch"
                    and row.get("headBranch") == branch
                    and row.get("createdAt", "") >= dispatched_after
                ):
                    run_row = row
                    break
        if run_row is not None:
            if not announced:
                print(f"  build: {run_row['url']}")
                announced = True
            if run_row["status"] == "completed":
                if run_row.get("conclusion") == "success":
                    return run_row
                print(
                    "create-release FAILED: build finished with"
                    f" {run_row.get('conclusion')}",
                    file=sys.stderr,
                )
                print(
                    f"  logs: gh run view {run_row['databaseId']}"
                    f" --repo {repo} --log-failed",
                    file=sys.stderr,
                )
                return None
        time.sleep(POLL_INTERVAL)
    print(
        "create-release FAILED: timed out waiting for the run to start or finish",
        file=sys.stderr,
    )
    print(
        f"  check: gh run list --repo {repo} --workflow={WORKFLOW}",
        file=sys.stderr,
    )
    return None


def verify_release(repo: str, tag: str) -> int:
    """Print the release URL and check all four binaries got attached."""
    result = probe(
        ["gh", "release", "view", tag, "--repo", repo, "--json", "url,assets"]
    )
    if result.returncode != 0:
        print(
            f"create-release FAILED: release {tag} is not visible yet;"
            f" check the Actions run",
            file=sys.stderr,
        )
        return 1
    data = json.loads(result.stdout)
    names = [a["name"] for a in data.get("assets", [])]
    print(f"published: {data['url']}")
    missing = [a for a in ASSETS if a not in names]
    if missing:
        print(
            f"warning: missing assets: {', '.join(missing)}"
            f" (install-wizard's download path needs all of them)",
            file=sys.stderr,
        )
        return 1
    print(f"  assets: {', '.join(names)}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Dispatch the Release workflow to bump, build, and publish"
            " (scripts/create-release -h for details)."
        )
    )
    parser.add_argument(
        "part", nargs="?", choices=("patch", "minor", "major"),
        help="bump type; omit with --no-bump",
    )
    parser.add_argument(
        "-y", "--yes", action="store_true", help="skip the confirmation prompt"
    )
    parser.add_argument(
        "--no-bump",
        action="store_true",
        help="release the version already in Cargo.toml, no bump commit",
    )
    parser.add_argument(
        "--no-watch",
        action="store_true",
        help="exit after dispatching; don't wait for the build",
    )
    args = parser.parse_args()

    if args.part and args.no_bump:
        return fail("choose either a bump type or --no-bump, not both")

    if shutil.which("gh") is None:
        return fail("gh CLI not found on PATH (https://cli.github.com)")

    os.chdir(REPO_ROOT)
    repo = run(
        ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]
    )
    branch = run(
        ["gh", "repo", "view", "--json", "defaultBranchRef", "--jq", ".defaultBranchRef.name"]
    )

    # Hard gate: a disabled workflow would swallow the dispatch and the
    # script would just time out later.
    state = workflow_state(repo)
    if state is not None and state != "active":
        return fail(
            f"the Release workflow is {state!r} on {repo}; enable it first:\n"
            f"  gh workflow enable Release --repo {repo}\n"
            f"  (or https://github.com/{repo}/actions/workflows/{WORKFLOW}\n"
            f"   and click Enable workflow)"
        )

    version = origin_version(repo, branch)
    if version is None:
        return fail(f"cannot read the version from {branch} on {repo}")

    part = "none" if args.no_bump else args.part
    if part is None:
        parser.error(
            "pass a bump type (patch|minor|major),"
            " or --no-bump to release the version already in Cargo.toml"
        )
    tag = f"v{version}" if part == "none" else f"v{bump_version(version, part)}"

    if release_exists(repo, tag):
        return fail(f"release {tag} already exists; nothing to do")

    if part == "none":
        print(f"release: {tag} (no bump, from {branch}'s Cargo.toml)")
    else:
        print(f"release: {tag} (bump: {part}, {version} -> {tag[1:]})")
    print(f"  dispatch: {WORKFLOW} on {branch}")
    print(f"  build:    4 binaries attached; changelog generated by the workflow")
    confirm("Dispatch this release?", args.yes)

    dispatched_after = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    run(
        [
            "gh",
            "workflow",
            "run",
            WORKFLOW,
            "--repo",
            repo,
            "--ref",
            branch,
            "-f",
            f"part={part}",
        ]
    )
    print("dispatched")

    if args.no_watch:
        print("check on it with:")
        print(f"  gh run list --repo {repo} --workflow={WORKFLOW}")
        return 0

    if watch_build(repo, branch, dispatched_after) is None:
        return 1
    return verify_release(repo, tag)


if __name__ == "__main__":
    sys.exit(main())
